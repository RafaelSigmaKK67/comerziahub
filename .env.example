# ==========================================================================
# ComerziaHub — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# ==========================================================================

# --- Banco de dados (Supabase / PostgreSQL) --------------------------------
# No Dashboard do Supabase: Connect -> aba "ORMs" (Prisma) mostra as duas URLs.
# DATABASE_URL = "Transaction pooler" (porta 6543) com &pgbouncer=true no final
# DIRECT_URL   = "Direct connection" (porta 5432) — usada por db push/seed
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Autenticação (Auth.js / NextAuth v5) ---------------------------------
# Gere um segredo com: npx auth secret   (ou)  openssl rand -base64 32
AUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-32-bytes"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="ComerziaHub"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Mapas / Localização (integração futura) ------------------------------
NEXT_PUBLIC_MAPS_PROVIDER="none"
NEXT_PUBLIC_MAPS_API_KEY=""

# --- Upload de imagens (integração futura) --------------------------------
UPLOAD_PROVIDER="local"
# BLOB_READ_WRITE_TOKEN=""

# --- Pagamentos (integração futura) ---------------------------------------
PAYMENT_PROVIDER="mock"
# PAYMENT_API_KEY=""
